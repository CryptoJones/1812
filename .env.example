# Discord
DISCORD_TOKEN=your_discord_bot_token_here

# LLM Provider: openai | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API Keys (only the one matching your provider is required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Persona / system prompt (overridden per-server via /persona command)
SYSTEM_PROMPT=You are 1812, a helpful and friendly Discord chatbot.

# History
MAX_HISTORY_MESSAGES=20
SUMMARISE_AT=40

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Web sidecar
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Storage
DB_PATH=1812.db

# Auto-shutdown timer (minutes). Unset / empty = unbounded.
# CLI `--shutdown-after N` overrides this at runtime.
# SHUTDOWN_AFTER_MINUTES=120
